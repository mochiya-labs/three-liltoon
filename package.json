{
	"name": "@mochiya/three-liltoon",
	"version": "0.1.0",
	"description": "Unofficial lilToon material and shader integration for Three.js WebGL2",
	"license": "MIT",
	"author": {
		"name": "Mochiya",
		"url": "https://mochiya.org"
	},
	"homepage": "https://mochiya.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mochiya-labs/three-liltoon.git"
	},
	"bugs": {
		"url": "https://github.com/mochiya-labs/three-liltoon/issues"
	},
	"keywords": [
		"three.js",
		"liltoon",
		"gltf",
		"vrm",
		"webgl2"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./gltf": {
			"types": "./dist/gltf.d.ts",
			"import": "./dist/gltf.js"
		},
		"./vrm": {
			"types": "./dist/vrm.d.ts",
			"import": "./dist/vrm.js"
		},
		"./schema": "./dist/schema/MOCHIYA_materials_liltoon.schema.json"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"tools:setup": "tsx tools/shader-build/setup-toolchain.ts",
		"tools:check": "tsx tools/shader-build/check-toolchain.ts",
		"generate": "npm run generate:gltf-schema && tsx tools/generators/generate-material-schema.ts && tsx tools/generators/generate-render-states.ts && tsx tools/generators/generate-third-party-notices.ts",
		"generate:gltf-schema": "tsx tools/generators/generate-gltf-schema.ts",
		"package:stage": "node scripts/stage-package.mjs",
		"generate:all": "npm run generate && npm run shaders:build",
		"shaders:build": "tsx tools/shader-build/build-all.ts",
		"shaders:preprocess": "tsx tools/shader-build/preprocess.ts",
		"shaders:clean": "rimraf shader/generated src/generated",
		"shaders:rebuild": "npm run shaders:clean && npm run generate && npm run shaders:build",
		"test": "npm run generate:all && vitest run",
		"test:compiler": "npm run generate:all && vitest run test/compiler",
		"test:browser": "npm run example:build && playwright test",
		"test:parity": "tsx test/parity/run.ts",
		"test:parity:required": "tsx test/parity/run.ts --require-fixtures",
		"example:dev": "vite examples/basic-three",
		"example:build": "npm run build:package && vite build examples/basic-three",
		"example:viewer:dev": "npm --prefix examples/mochiya-liltoon-viewer run dev",
		"example:viewer:build": "npm --prefix examples/mochiya-liltoon-viewer run build",
		"typecheck": "npm run generate:all && tsc --noEmit",
		"build:package": "npm run generate:all && tsup && npm run package:stage",
		"build": "npm run generate:all && tsc --noEmit && tsup && npm run package:stage",
		"prepublishOnly": "npm run build && npm test"
	},
	"peerDependencies": {
		"@pixiv/three-vrm": ">=3.4.0 <4",
		"three": ">=0.180.0 <0.190.0"
	},
	"peerDependenciesMeta": {
		"@pixiv/three-vrm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@pixiv/three-vrm": "^3.5.5",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.3.0",
		"@types/pngjs": "^6.0.5",
		"@types/three": "^0.185.4",
		"ajv": "^8.20.0",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"prettier": "3.9.6",
		"rimraf": "^6.0.1",
		"three": "^0.180.0",
		"ts-json-schema-generator": "2.4.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"vite": "^7.1.3",
		"vitest": "^3.2.4"
	}
}
